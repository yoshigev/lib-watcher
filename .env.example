# ==========================================
# Security & Auth
# ==========================================
SECRET_KEY=change-this-to-a-very-secure-random-string-at-least-32-chars
CRON_SECRET=your-secret-token-for-cron-endpoint

# Predefined users created on startup (JSON Array)
SEED_USERS=[{"username": "admin", "email": "your_email@gmail.com", "password": "YourPassword123!"}]

# ==========================================
# Library Catalog Configuration (BuildaGate System)
# ==========================================
LIBRARY_BASE_URL=https://your-city.libraries.co.il
LIBRARY_SITE_NAME=LIB_your-site-id
LIBRARY_NEW_NAME_MADE=30213
LIBRARY_BUYER_ID=285010242
LIBRARY_DISPLAY_NAME=הספרייה העירונית

# ==========================================
# Database (MongoDB Atlas M0 Free Tier or Local)
# ==========================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=library_catalog_db

# ==========================================
# Email Notifications (Brevo / Sendinblue)
# ==========================================
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=your_email@gmail.com
BREVO_SENDER_NAME=התראות ספרייה

# Optional WatchCron management API credentials (not needed by the app runtime)
WATCHCRON_API_BASE_URL=https://watchcron.com/api/v1
WATCHCRON_API_KEY=your-watchcron-api-key

# ==========================================
# Optional Settings
# ==========================================
ENABLE_INTERNAL_SCHEDULER=False
POLL_INTERVAL_MINUTES=15
